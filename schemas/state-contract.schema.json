{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architectpass.local/schemas/state-contract.schema.json",
  "title": "ArchitectPass State Contract",
  "schema_version": 1,
  "$defs": {
    "source_ref": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "resource_id": {"type": "string"},
        "pdf_page": {"type": "integer", "minimum": 1},
        "video_start_seconds": {"type": "number", "minimum": 0},
        "video_end_seconds": {"type": "number", "minimum": 0},
        "cheko_test_id": {"type": "string"},
        "cheko_result_id": {"type": "string"},
        "web_url": {"type": "string", "format": "uri"}
      },
      "additionalProperties": false
    },
    "write_context": {
      "type": "object",
      "required": ["request_id", "audit_id", "actor"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "audit_id": {"type": "string", "minLength": 1},
        "actor": {"type": "string", "minLength": 1},
        "user_confirmed": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    },
    "study_event": {
      "type": "object",
      "required": ["event_id", "event_type", "occurred_at", "source_ref"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "event_type": {"type": "string", "minLength": 1},
        "topic_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "session_id": {"type": ["string", "null"]},
        "payload": {"type": "object"},
        "source_ref": {"$ref": "#/$defs/source_ref"},
        "occurred_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "mastery_evidence": {
      "type": "object",
      "required": ["evidence_id", "topic_id", "evidence_type", "score", "confidence", "source_id", "created_at"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "topic_id": {"type": "string", "minLength": 1},
        "evidence_type": {"enum": ["viewed", "open_book_recall", "closed_book_recall", "choice_untimed", "choice_timed", "case_points", "essay_application", "timed_mock"]},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "difficulty": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "timed": {"type": "boolean"},
        "source_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "expires_or_decay_rule": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "practice_attempt": {
      "type": "object",
      "required": ["attempt_id", "platform", "question_or_set_id", "topic_ids", "correct", "confidence", "duration", "source_evidence", "submitted_at"],
      "properties": {
        "attempt_id": {"type": "string", "minLength": 1},
        "platform": {"const": "cheko"},
        "question_or_set_id": {"type": "string", "minLength": 1},
        "topic_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "correct": {"type": "boolean"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "duration": {"type": "number", "minimum": 0},
        "error_type": {"type": ["string", "null"], "enum": ["K", "C", "M", "A", "Q", "T", "E", "G", null]},
        "source_evidence": {
          "type": "object",
          "required": ["cheko_result_id", "visible_item_id", "import_method", "ui_contract_version"],
          "properties": {
            "cheko_result_id": {"type": "string", "minLength": 1},
            "visible_item_id": {"type": "string", "minLength": 1},
            "import_method": {"enum": ["visible_submitted_report", "official_export", "screenshot", "manual_summary"]},
            "ui_contract_version": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "submitted_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "mastery_state": {
      "type": "object",
      "required": ["topic_id", "level_0_to_5", "confidence", "risk_flags", "derivation"],
      "properties": {
        "topic_id": {"type": "string"},
        "level_0_to_5": {"type": "integer", "minimum": 0, "maximum": 5},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "last_verified_at": {"type": ["string", "null"], "format": "date-time"},
        "next_review_at": {"type": ["string", "null"], "format": "date-time"},
        "risk_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "derivation": {
          "type": "object",
          "required": ["evidence_ids", "rule_version"],
          "properties": {
            "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "rule_version": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "case_attempt": {
      "type": "object",
      "required": ["case_id", "question_source", "user_answer", "rubric", "covered_points", "missing_points", "irrelevant_content", "time_used", "score_estimate", "review_due"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "question_source": {"$ref": "#/$defs/source_ref"},
        "user_answer": {"type": "string", "minLength": 1},
        "rubric": {"type": "array", "minItems": 1},
        "covered_points": {"type": "array"},
        "missing_points": {"type": "array"},
        "irrelevant_content": {"type": "array"},
        "time_used": {"type": "number", "minimum": 0},
        "score_estimate": {"type": "number", "minimum": 0, "maximum": 1},
        "review_due": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "essay_attempt": {
      "type": "object",
      "required": ["essay_id", "topic", "outline_or_full", "project_fact_ids", "word_count", "time_used", "rubric_results", "factual_risks", "revision_history"],
      "properties": {
        "essay_id": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "outline_or_full": {"enum": ["outline", "partial_paragraph", "full", "revision", "spaced_rewrite"]},
        "project_fact_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "word_count": {"type": "integer", "minimum": 0},
        "time_used": {"type": "number", "minimum": 0},
        "rubric_results": {"type": "object"},
        "factual_risks": {"type": "array"},
        "revision_history": {"type": "array", "minItems": 1}
      },
      "additionalProperties": false
    }
  }
}

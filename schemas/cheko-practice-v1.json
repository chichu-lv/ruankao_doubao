{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architectpass.local/schemas/cheko-practice-v1.json",
  "title": "ArchitectPass Cheko practice contract v1",
  "type": "object",
  "$defs": {
    "write_context": {
      "type": "object",
      "required": ["request_id", "audit_id", "actor"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "audit_id": {"type": "string", "minLength": 1},
        "actor": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["task_id", "subject", "paper_type", "practice_mode", "target", "question_count", "time_limit_minutes", "completion_standard", "confidence_capture", "navigation_target"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "subject": {"const": "系统架构设计师"},
        "paper_type": {"enum": ["choice", "case", "essay"]},
        "practice_mode": {"enum": ["chapter", "past_exam", "wrong_questions", "daily", "manual", "custom"]},
        "target": {"type": "string", "minLength": 1},
        "question_count": {"type": "integer", "minimum": 1, "maximum": 100},
        "time_limit_minutes": {"type": "integer", "minimum": 1, "maximum": 180},
        "completion_standard": {"type": "string", "minLength": 1},
        "confidence_capture": {"enum": ["per_item", "per_group"]},
        "data_purpose": {"enum": ["learning", "workflow_test"], "default": "learning"},
        "navigation_target": {
          "type": "object",
          "required": ["name", "route"],
          "properties": {
            "name": {"enum": ["chapter_bank", "custom_paper", "past_exam", "error_book", "practice_log"]},
            "route": {"enum": ["/?subject=0", "/past_exam?subject=0", "/error_book?subject=0", "/test_log?subject=0"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "result_item": {
      "type": "object",
      "required": ["visible_item_id", "topic_id", "correct", "confidence", "duration_seconds"],
      "properties": {
        "visible_item_id": {"type": "string", "minLength": 1},
        "topic_id": {"type": "string", "minLength": 1},
        "correct": {"type": "boolean"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "duration_seconds": {"type": "number", "minimum": 0},
        "error_type": {"type": ["string", "null"], "enum": ["K", "C", "M", "A", "Q", "T", "E", "G", null]}
      },
      "additionalProperties": false
    },
    "submitted_result": {
      "type": "object",
      "required": ["submission_state", "import_method", "cheko_result_id", "observed_at", "ui_contract_version"],
      "properties": {
        "submission_state": {"const": "submitted"},
        "import_method": {"enum": ["visible_submitted_report", "official_export", "screenshot", "manual_summary"]},
        "cheko_result_id": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "ui_contract_version": {"type": "string", "minLength": 1},
        "summary": {
          "type": "object",
          "properties": {
            "practice_type": {"type": "string"},
            "topic": {"type": "string"},
            "created_at_display": {"type": "string"},
            "question_count": {"type": "integer", "minimum": 1},
            "main_question_count": {"type": "integer", "minimum": 1, "maximum": 100},
            "answer_item_count": {"type": "integer", "minimum": 1, "maximum": 200},
            "correct_answer_item_count": {"type": "integer", "minimum": 0, "maximum": 200},
            "accuracy_percent": {"type": "number", "minimum": 0, "maximum": 100},
            "score_display": {"type": "string"},
            "elapsed_display": {"type": "string"}
          },
          "additionalProperties": false
        },
        "items": {"type": "array", "items": {"$ref": "#/$defs/result_item"}}
      },
      "anyOf": [{"required": ["summary"]}, {"required": ["items"]}],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "write_context", "task", "result"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "write_context": {"$ref": "#/$defs/write_context"},
    "task": {"$ref": "#/$defs/task"},
    "result": {"$ref": "#/$defs/submitted_result"}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architectpass.local/schemas/material-manifest-v1.json",
  "title": "ArchitectPass material manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "write_context", "authorization", "resources"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "write_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "audit_id", "actor"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "audit_id": {"type": "string", "minLength": 1},
        "actor": {"type": "string", "minLength": 1}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "privacy", "allowed_remote_roots"],
      "properties": {
        "purpose": {"const": "personal_exam_study"},
        "privacy": {"const": "private"},
        "allowed_remote_roots": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["remote_root", "relative_path", "kind", "status", "source_anchor"],
        "properties": {
          "remote_root": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "minLength": 1},
          "kind": {"enum": ["folder", "pdf", "video", "audio", "subtitle", "other"]},
          "size_bytes": {"type": ["integer", "null"], "minimum": 0},
          "visible_size": {"type": ["string", "null"]},
          "checksum": {"type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64})?$"},
          "status": {"enum": ["remote_inventory_only", "local_pending", "partially_indexed", "indexed", "quarantined"]},
          "indexed_ranges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start_seconds", "end_seconds", "source_anchor"],
              "properties": {
                "start_seconds": {"type": "number", "minimum": 0},
                "end_seconds": {"type": "number", "exclusiveMinimum": 0},
                "source_anchor": {"type": "string", "minLength": 1}
              }
            }
          },
          "source_anchor": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
